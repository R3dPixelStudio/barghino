    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
