{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barghino",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*", "/api/*", "/media/*", "/fa/journal", "/fa/journal/*", "/en/journal", "/en/journal/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "barghino-content",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": { "SITE_ORIGIN": "", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
